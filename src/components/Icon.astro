---
type IconName = "home" | "calendar" | "book" | "tag" | "chevron-right" | "sun" | "moon" | "github" | "menu";

interface Props {
  name: IconName;
}

const { name } = Astro.props;
const strokeProps = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": 2,
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
} as const;
---

{
	name !== "github" ? (
		<svg viewBox="0 0 24 24" aria-hidden="true" {...strokeProps}>
			{name === "home" && (
				<>
					<path d="M3 10.5 12 3l9 7.5" />
					<path d="M5 9.5V21h5v-6h4v6h5V9.5" />
				</>
			)}
			{name === "calendar" && (
				<>
					<rect x="3" y="4" width="18" height="18" rx="2" />
					<path d="M16 2v4M8 2v4M3 10h18" />
				</>
			)}
			{name === "book" && (
				<>
					<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
					<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
				</>
			)}
			{name === "tag" && (
				<>
					<path d="M20.59 13.41 11 3H4v7l9.59 9.59a2 2 0 0 0 2.82 0l4.18-4.18a2 2 0 0 0 0-2.82z" />
					<path d="M7.5 7.5h.01" />
				</>
			)}
			{name === "chevron-right" && <path d="M9 18l6-6-6-6" />}
			{name === "sun" && (
				<>
					<circle cx="12" cy="12" r="5" />
					<path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
				</>
			)}
			{name === "moon" && <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />}
			{name === "menu" && <path d="M3 12h18M3 6h18M3 18h18" />}
		</svg>
	) : (
		<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
		</svg>
	)
}

<style>
	svg {
		width: 1em;
		height: 1em;
		display: block;
		flex: none;
	}
</style>
