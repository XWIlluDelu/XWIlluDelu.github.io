---
import { withBase } from "../lib/urls";
import { getSiteTheme } from "../lib/site-theme";

const { banner, season } = await getSiteTheme();
---

<figure class="banner" transition:name="site-banner" data-season={season}>
	<img src={withBase(banner.src)} alt="Site banner" style="object-position: center" loading="lazy" />
	{banner.credit && (
		<figcaption class="banner-credit">
			<a href={banner.credit.url} target="_blank" rel="noopener noreferrer">© {banner.credit.text} ↗</a>
		</figcaption>
	)}
</figure>

<style>
	.banner {
		position: relative;
		width: 100vw;
		max-width: 100vw;
		margin: -6rem calc(50% - 50vw) 0;
		height: 40vh;
		min-height: 22rem;
		overflow: hidden;
	}

	.banner-credit {
		position: absolute;
		right: 1rem;
		bottom: 1rem;
		max-width: calc(100% - 2rem);
		font-size: 0.75rem;
	}

	.banner-credit a {
		display: block;
		padding: 0.35rem 0.7rem;
		border-radius: 1rem;
		background: rgb(0 0 0 / 0.65);
		color: white;
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.banner-credit a:hover { background: rgb(0 0 0 / 0.8); }

	.banner img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
