---
import { getEntry } from "astro:content";
import { withBase } from "../lib/urls";

const site = await getEntry("site", "config");
if (!site) throw new Error("Site config not found");
---

<figure class="banner" transition:name="site-banner">
	<img src={withBase(site.data.banner.src)} alt="Site banner" style="object-position: center" loading="lazy" />
</figure>

<style>
	.banner {
		position: relative;
		width: 100vw;
		max-width: 100vw;
		margin: -6rem calc(50% - 50vw) 0;
		height: 40vh;
		min-height: 22rem;
		overflow: hidden;
	}

	.banner img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
