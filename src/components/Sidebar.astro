---
import { categoryUrl, tagUrl } from "@/lib/urls";
import Icon from "./Icon.astro";

interface Props {
  tags: { name: string; count: number }[];
  categories: { name: string; count: number }[];
}

const { tags, categories } = Astro.props;
---

<aside class="sidebar">
	<section class="card profile">
		<a class="profile-avatar-link" href="/about/" aria-label="Go to About Page">
			<img class="profile-avatar" src="/images/demo-avatar.png" alt="Profile image" loading="lazy" />
			<span class="profile-avatar-overlay" aria-hidden="true">
				<Icon name="id-card" />
			</span>
		</a>
		<p class="profile-name">Your Name</p>
		<div class="profile-bar"></div>
		<p class="profile-bio">A short bio.</p>
		<ul class="profile-links">
			<li>
				<a href="https://github.com/" target="_blank" rel="me noopener" aria-label="GitHub">
					<Icon name="github" />
				</a>
			</li>
		</ul>
	</section>
	<section class="card">
		<p class="widget-title">Categories</p>
		<ul class="category-list">
			{categories.map((c) => (
				<li>
					<a href={categoryUrl(c.name)}>
						{c.name}
						<span class="count-badge">{c.count}</span>
					</a>
				</li>
			))}
		</ul>
	</section>
	<section class="card">
		<p class="widget-title">Tags</p>
		<ul class="tag-list">
			{tags.map((tag) => (
				<li><a href={tagUrl(tag.name)}>{tag.name}</a></li>
			))}
		</ul>
	</section>
</aside>

<style>
	.sidebar {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.profile {
		text-align: center;
	}

	.profile-avatar {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 0.75rem;
	}

	.profile-avatar-link {
		position: relative;
		display: block;
		max-width: 12rem;
		margin: 0 auto;
		border-radius: 0.75rem;
		font-size: 3rem;
	}

	.profile-avatar-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.75rem;
		background: rgb(0 0 0 / 0.35);
		color: #fff;
		opacity: 0;
		transition: opacity 0.2s;
		pointer-events: none;
	}

	.profile-avatar-link:hover .profile-avatar-overlay,
	.profile-avatar-link:focus-visible .profile-avatar-overlay {
		opacity: 1;
	}

	.profile-name {
		font-size: 1.25rem;
		font-weight: 800;
		margin: 0.8rem 0 0.4rem;
	}

	.profile-bar {
		width: 1.5rem;
		height: 0.25rem;
		background: var(--primary);
		border-radius: 999px;
		margin: 0 auto 0.6rem;
	}

	.profile-bio {
		color: var(--text-muted);
		margin: 0 0 0.9rem;
	}

	.profile-links {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 1.5rem;
	}

	.profile-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.8rem;
		background: var(--btn-bg);
		color: var(--primary);
	}

	.profile-links a:hover {
		background: var(--btn-bg-hover);
		color: var(--primary);
	}

	.widget-title {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 800;
		margin: 0 0 0.8rem;
		font-size: 1.05rem;
	}

	.widget-title::before {
		content: "";
		width: 0.25rem;
		height: 1.1rem;
		border-radius: 999px;
		background: var(--primary);
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tag-list a {
		display: inline-block;
		background: var(--btn-bg);
		color: var(--text);
		text-decoration: none;
		border-radius: 0.65rem;
		padding: 0.32rem 0.75rem;
		font-size: 0.875rem;
		font-weight: 600;
	}

	.tag-list a:hover {
		background: var(--btn-bg-hover);
		color: var(--primary);
	}

	.category-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.category-list a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		color: var(--text);
		text-decoration: none;
		font-weight: 600;
		border-radius: 0.65rem;
		padding: 0.45rem 0.6rem 0.45rem 0.75rem;
	}

	.category-list a:hover {
		background: var(--btn-bg-hover);
		color: var(--primary);
	}

	.count-badge {
		background: var(--btn-bg);
		color: var(--primary);
		border-radius: 0.55rem;
		font-size: 0.8rem;
		font-weight: 800;
		min-width: 2rem;
		height: 1.75rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0 0.5rem;
	}

	.category-list a:hover .count-badge {
		background: var(--primary);
		color: #fff;
	}
</style>
