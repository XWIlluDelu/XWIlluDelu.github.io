---
import { render } from "astro:content";
import { getCategoryList, getPostsWithNav, getSortedPosts, getTagList } from "@/lib/content";
import { formatDateToYYYYMMDD } from "@/lib/dates";
import { computeReadingStats } from "@/lib/reading";
import { categoryUrl, postUrl, tagUrl } from "@/lib/urls";
import Icon from "../../components/Icon.astro";
import Markdown from "../../components/Markdown.astro";
import Banner from "../../components/Banner.astro";
import Sidebar from "../../components/Sidebar.astro";
import TOC from "../../components/TOC.astro";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((item) => ({ params: { slug: item.slug }, props: { slug: item.slug } }));
}

const { slug } = Astro.props as { slug: string };
const withNav = await getPostsWithNav();
const current = withNav.find((p) => p.slug === slug);
if (!current) throw new Error(`Post not found: ${slug}`);
const { Content, headings } = await render(current.entry);
const stats = computeReadingStats(current.entry.body ?? "");
const data = current.entry.data;
const tags = await getTagList();
const categories = await getCategoryList();
---

<Base title={data.title} description={data.description}>
	<Banner />
	<div class="layout">
		<Sidebar tags={tags} categories={categories} />
		<div>
			<article class="card">
			<div class="post-meta">
				<span class="meta">
					<span class="meta-icon"><Icon name="calendar" /></span>
					{stats.words} {stats.words === 1 ? "word" : "words"}
				</span>
				<span class="meta">
					<span class="meta-icon"><Icon name="book" /></span>
					{stats.minutes} {stats.minutes === 1 ? "minute" : "minutes"}
				</span>
			</div>
			<h1 class="article-title">{data.title}</h1>
		<div class="post-meta">
			<span class="meta">
				<span class="meta-icon"><Icon name="calendar" /></span>
				<time datetime={data.published.toISOString()}>{formatDateToYYYYMMDD(data.published)}</time>
			</span>
			{data.category && (
				<span class="meta">
					<span class="meta-icon"><Icon name="book" /></span>
					<a href={categoryUrl(data.category)}>{data.category}</a>
				</span>
			)}
			{data.tags.length > 0 && (
				<span class="meta">
					<span class="meta-icon"><Icon name="tag" /></span>
					{data.tags.map((tag, i) => (
						<>
							{i > 0 && <span class="tag-sep">/</span>}
							<a href={tagUrl(tag)}>{tag}</a>
						</>
					))}
				</span>
			)}
			</div>
		<div class="post-divider"></div>
		{data.image && <img class="post-cover" src={data.image} alt="" loading="lazy" />}
		<div class="post-grid">
			<Markdown>
				<Content />
			</Markdown>
			<div class="toc-side">
				<TOC headings={headings} />
			</div>
		</div>
	</article>
	<nav class="pagination">
		{current.nextSlug && <a href={postUrl(current.nextSlug)} rel="next">← {current.nextTitle}</a>}
		{current.prevSlug && <a href={postUrl(current.prevSlug)} rel="prev">{current.prevTitle} →</a>}
	</nav>
		</div>
	</div>
</Base>

<style>
	.article-title {
		position: relative;
		margin: 0 0 0.8rem;
		font-size: 2.1rem;
		line-height: 1.25;
		padding-left: 1rem;
	}

	.article-title::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.45rem;
		bottom: 0.45rem;
		width: 0.3rem;
		border-radius: 999px;
		background: var(--primary);
	}

	.post-meta {
		color: var(--text-muted);
		font-size: 0.875rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		margin-bottom: 0.7rem;
	}

	.meta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
	}

	.meta-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 0.55rem;
		background: var(--btn-bg);
		color: var(--primary);
		font-size: 1.25rem;
	}

	.post-meta a {
		color: var(--text-muted);
		text-decoration: none;
	}

	.post-meta a:hover {
		color: var(--primary);
	}

	.tag-sep {
		opacity: 0.5;
		margin: 0 0.1rem;
	}

	.post-cover {
		border-radius: 0.9rem;
		margin-bottom: 0.9rem;
		width: 100%;
		max-height: 24rem;
		object-fit: cover;
	}

	.post-divider {
		border-bottom: 1px dashed var(--line);
		margin: 0.4rem 0 1.2rem;
	}

	.post-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		min-width: 0;
	}

	.toc-side {
		display: none;
		min-width: 0;
	}

	@media (min-width: 110rem) {
		.post-grid {
			grid-template-columns: minmax(0, 1fr) 15rem;
			align-items: start;
		}

		.toc-side {
			display: block;
			position: sticky;
			top: 6rem;
		}
	}

	.pagination {
		display: flex;
		gap: 0.5rem;
		justify-content: center;
		margin-top: 1.5rem;
		flex-wrap: wrap;
	}

	.pagination a {
		display: inline-flex;
		align-items: center;
		border-radius: 0.8rem;
		background: var(--card-bg);
		border: 1px solid var(--line);
		color: var(--text);
		text-decoration: none;
		font-weight: 700;
		padding: 0.7rem 1.1rem;
		box-shadow: var(--shadow);
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.pagination a:hover {
		border-color: var(--primary);
		color: var(--primary);
	}
</style>


