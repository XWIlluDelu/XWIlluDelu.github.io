---
import { getCategoryList, getSortedPosts } from "@/lib/content";
import { computeReadingStats } from "@/lib/reading";
import { postUrl, slugify } from "@/lib/urls";
import PostCard from "../../components/PostCard.astro";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const categories = await getCategoryList();
  return categories.map((c) => ({
    params: { category: slugify(c.name) },
    props: { name: c.name },
  }));
}

const { name } = Astro.props as { name: string };
const posts = (await getSortedPosts()).filter((p) => p.entry.data.category === name);
---

<Base title={`Category: ${name}`} description={`Posts in ${name}`}>
	<h1>Category: {name}</h1>
	{
		posts.map((item) => {
			const stats = computeReadingStats(item.entry.body ?? "");
			return (
				<PostCard
					title={item.title}
					url={postUrl(item.slug)}
					published={item.published}
					tags={item.entry.data.tags}
					category={item.entry.data.category}
					description={item.entry.data.description}
					image={item.entry.data.image || undefined}
					words={stats.words}
					minutes={stats.minutes}
				/>
			);
		})
	}
</Base>
