---
import { ClientRouter } from "astro:transitions";
import { getEntry } from "astro:content";
import Icon from "../components/Icon.astro";
import { withBase } from "../lib/urls";
import "../styles/tokens.css";

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;
const site = await getEntry("site", "config");
if (!site) throw new Error("Site config not found");
const pageTitle = title ? `${title} - ${site.data.title}` : `${site.data.title} - ${site.data.subtitle}`;
const pageDescription = description ?? site.data.subtitle;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{pageTitle}</title>
		<link rel="icon" href={withBase("/favicon/favicon-light-32.png")} sizes="32x32" media="(prefers-color-scheme: light)" />
		<link rel="icon" href={withBase("/favicon/favicon-dark-32.png")} sizes="32x32" media="(prefers-color-scheme: dark)" />
		<link rel="icon" href={withBase("/favicon/favicon-light-192.png")} sizes="192x192" media="(prefers-color-scheme: light)" />
		<link rel="icon" href={withBase("/favicon/favicon-dark-192.png")} sizes="192x192" media="(prefers-color-scheme: dark)" />
		<ClientRouter />
		<script is:inline>
			try {
				const stored = localStorage.getItem("huwari-theme");
				const theme =
					stored === "light" || stored === "dark"
						? stored
						: window.matchMedia("(prefers-color-scheme: dark)").matches
							? "dark"
							: "light";
				document.documentElement.dataset.theme = theme;
			} catch {
			}
		</script>
		<slot name="head" />
	</head>
	<body>
		<header class="navbar" transition:name="site-header">
			<div class="navbar-inner">
				<a class="brand" href={withBase("/")}>
					<span class="brand-icon"><Icon name="home" /></span>
					{site.data.title}
				</a>
				<nav class="nav-links" aria-label="Primary">
					<a href={withBase("/")}>Home</a>
					<a href={withBase("/archive/")}>Archive</a>
					<a href={withBase("/about/")}>About</a>
					{site.data.navigation?.map((link) => (
						<a href={link.url} target="_blank" rel="noopener noreferrer">{link.name} ↗</a>
					))}
				</nav>
				<div class="nav-actions">
					<button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle theme">
						<span class="icon-sun"><Icon name="sun" /></span>
						<span class="icon-moon"><Icon name="moon" /></span>
					</button>
					<details class="nav-menu">
						<summary aria-label="Menu"><Icon name="menu" /></summary>
						<div class="nav-menu-panel card">
							<a href={withBase("/")}>Home</a>
							<a href={withBase("/archive/")}>Archive</a>
							<a href={withBase("/about/")}>About</a>
							{site.data.navigation?.map((link) => (
								<a href={link.url} target="_blank" rel="noopener noreferrer">{link.name} ↗</a>
							))}
						</div>
					</details>
				</div>
			</div>
		</header>
		<div class="page page-overlap">
			<div transition:animate="fade">
				<slot />
			</div>
			<footer class="footer">
				© {new Date().getFullYear()} {site.data.title} · <a href={withBase("/rss.xml")}>RSS</a> ·{" "}
				<a href={withBase("/sitemap-index.xml")}>Sitemap</a>
			</footer>
		</div>
		<script>
			import { initTheme, theme } from "../stores/theme";

			theme.set(document.documentElement.dataset.theme === "dark" ? "dark" : "light");
			initTheme();
		</script>
	</body>
</html>

<style>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		background: var(--page-bg);
		color: var(--text);
		font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
		line-height: 1.7;
		transition: background 0.2s, color 0.2s;
		overflow-x: clip;
	}

	body {
		margin: 0;
	}

	::selection {
		background: var(--selection);
	}

	a {
		color: var(--primary);
	}

	img {
		max-width: 100%;
		height: auto;
	}

	.navbar {
		position: sticky;
		top: 0;
		z-index: 50;
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 0 1rem;
		pointer-events: none;
	}

	.navbar-inner {
		pointer-events: auto;
		background: var(--card-bg);
		border: 1px solid var(--line);
		border-top: none;
		border-radius: 0 0 var(--radius) var(--radius);
		box-shadow: var(--shadow);
		height: 4.5rem;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		padding: 0 0.75rem 0 1.25rem;
	}

	.brand {
		justify-self: start;
	}

	.nav-links {
		justify-self: center;
	}

	.nav-actions {
		justify-self: end;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 800;
		font-size: 1.2rem;
		color: var(--primary);
		text-decoration: none;
	}

	.brand-icon {
		font-size: 1.75rem;
		display: inline-flex;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.nav-links a {
		color: var(--text);
		text-decoration: none;
		font-weight: 700;
		padding: 0.55rem 1rem;
		border-radius: 0.7rem;
	}

	.nav-links a:hover {
		background: var(--btn-bg-hover);
		color: var(--primary);
	}

	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid transparent;
		background: transparent;
		color: var(--text);
		border-radius: 0.7rem;
		width: 2.75rem;
		height: 2.75rem;
		font-size: 1.25rem;
		cursor: pointer;
	}

	.theme-toggle:hover {
		background: var(--btn-bg-hover);
		color: var(--primary);
	}

	.icon-moon {
		display: none;
	}

	:global(:root[data-theme="dark"]) .icon-sun {
		display: none;
	}

	:global(:root[data-theme="dark"]) .icon-moon {
		display: block;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.nav-menu {
		display: none;
		position: relative;
		font-size: 1.25rem;
	}

	.nav-menu summary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.7rem;
		cursor: pointer;
		list-style: none;
	}

	.nav-menu summary::-webkit-details-marker {
		display: none;
	}

	.nav-menu summary:hover {
		background: var(--btn-bg-hover);
		color: var(--primary);
	}

	.nav-menu-panel {
		position: absolute;
		right: 0;
		top: calc(100% + 0.5rem);
		min-width: 12rem;
		padding: 0.5rem;
		display: flex;
		flex-direction: column;
	}

	.nav-menu-panel a {
		color: var(--text);
		text-decoration: none;
		font-weight: 700;
		padding: 0.6rem 0.9rem;
		border-radius: 0.6rem;
	}

	.nav-menu-panel a:hover {
		background: var(--btn-bg-hover);
		color: var(--primary);
	}

	@media (max-width: 47.99rem) {
		.nav-links {
			display: none;
		}

		.nav-menu {
			display: block;
		}
	}

	.page {
		max-width: var(--page-width);
		margin: 1.5rem auto 0;
		padding: 0 1rem 4rem;
		position: relative;
		z-index: 1;
	}

	.page-overlap {
		margin-top: -3.5rem;
	}

	.footer {
		margin-top: 2.5rem;
		border: 1px dashed color-mix(in srgb, var(--primary) 25%, transparent);
		border-radius: var(--radius);
		background: var(--card-bg);
		padding: 1.75rem 1rem;
		color: var(--text-muted);
		font-size: 0.875rem;
		text-align: center;
	}
</style>
